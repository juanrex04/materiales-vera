# ============================================================
# VARIABLES DE ENTORNO - BACKEND (Produccion)
# Copia este archivo a .env y completa los valores reales.
# ============================================================

# Puerto donde escucha el servidor Express
PORT=3000

# Conexion a la base de datos MySQL 8+
# En produccion NO uses el usuario root: crea uno dedicado
# (ej: CREATE USER 'materiales'@'localhost' IDENTIFIED BY '...';)
DB_HOST=localhost
DB_USER=materiales
DB_PASSWORD=cambia_esta_password
DB_DATABASE=materiales_vera

# Secreto para firmar los JWT.
# Genera uno largo y aleatorio, ej: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=genera_un_secret_largo_y_aleatorio_aqui

# Origen(es) permitido(s) por CORS, separados por coma.
# En produccion = dominio real del frontend (sin barra final).
# Ej: https://app.materialesvera.com
CORS_ORIGIN=https://app.materialesvera.com
