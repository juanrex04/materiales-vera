# ============================================================
# VARIABLES DE ENTORNO - BACKEND (Render + TiDB Cloud)
# Render NO usa un archivo .env: pega cada variable en el panel
# del servicio (Render Dashboard -> su Web Service -> Environment).
# ============================================================

# Puerto donde escucha el servidor Express.
# Render inyecta PORT automaticamente. NO lo cambies.
PORT=3000

# --- Base de datos TiDB Cloud (Serverless) ---
# Al crear el cluster en TiDB Cloud, usa "Connect" -> "General connection"
# para obtener host/puerto/usuario/password/database reales.
DB_HOST=gateway01.xxxxxxxx.aws.tidbcloud.com
DB_PORT=4000
DB_USER=root
DB_PASSWORD=tu_password_de_tidb
DB_DATABASE=materiales_vera

# Secreto para firmar los JWT.
# Genera uno largo y aleatorio: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=genera_un_secret_largo_y_aleatorio_aqui

# Origen(es) permitido(s) por CORS, separados por coma.
# En Render = la URL del Static Site del frontend (sin barra final).
# Ej: https://materiales-vera-frontend.onrender.com
CORS_ORIGIN=https://materiales-vera-frontend.onrender.com
