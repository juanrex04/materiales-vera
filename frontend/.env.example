# ============================================================
# VARIABLES DE ENTORNO - FRONTEND (Vite)
# Copia este archivo a .env con los valores reales y
# vuelve a ejecutar "npm run build" para que tome efecto.
# ============================================================

# URL base de la API (backend). En produccion debe ser la URL
# publica del servidor, SIN barra final.
# Ej: https://api.materialesvera.com
VITE_API_URL=https://api.materialesvera.com
